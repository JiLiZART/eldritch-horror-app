{
  "name": "eldritch-horror-app",
  "version": "1.0.0",
  "description": "Browser app for the Eldritch Horror board game (fan project)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "content:validate": "tsx scripts/validate-content.ts",
    "content:extract-icons": "tsx scripts/extract-icons.ts",
    "content:copy-core": "tsx scripts/copy-core-assets.ts",
    "content:board-overlay": "tsx scripts/board-overlay.ts",
    "content:board-localization": "tsx scripts/board-localization.ts"
  },
  "author": "",
  "license": "UNLICENSED",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.0.9",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "private": true,
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  }
}
